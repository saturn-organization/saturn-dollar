# Localhost RPC URL
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Mainnet RPC URLs
MAINNET_RPC_URL=

# Used for verifying contracts on Etherscan
ETHERSCAN_API_KEY=

MAINNET_VERIFIER_URL=https://api.etherscan.io/v2/api?chainid=1

# Timelock proposer: the Fireblocks MPC wallet holding PROPOSER_ROLE. Passed as --sender to
# propose-upgrade-calldata (simulation) and propose-upgrade, which broadcasts unsigned so MPC signs.
PROPOSER_ADDRESS=0x610182581C93687Ca03F4a8E7f124f8cEC616820

# Fireblocks API credentials, read by the fireblocks-json-rpc SDK so the MPC wallet can sign
# schedule(). Only propose-upgrade needs them; propose-upgrade-calldata is a dry run.
FIREBLOCKS_API_KEY=
FIREBLOCKS_API_PRIVATE_KEY_PATH=

# Any funded EOA. Signs execute-upgrade — the timelock's EXECUTOR_ROLE is open to everyone.
PRIVATE_KEY=
