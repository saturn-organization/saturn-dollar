# Localhost RPC URL
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Mainnet RPC URLs
MAINNET_RPC_URL=

# Used for verifying contracts on Etherscan
ETHERSCAN_API_KEY=

MAINNET_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=1"

# Timelock proposer EOA (0x610182581C93687Ca03F4a8E7f124f8cEC616820).
# Signs propose-upgrade, which deploys the implementation and schedules the upgrade.
PROPOSER_PRIVATE_KEY=

# Any funded EOA. Signs execute-upgrade — the timelock's EXECUTOR_ROLE is open to everyone.
PRIVATE_KEY=

# Implementation address printed by propose-upgrade. Required by execute-upgrade.
NEW_IMPLEMENTATION=
